{
  "manifest_version": 3,
  "name": "Gulnux sök",
  "version": "0.1.0",
  "description": "Spara sidan du läser i Gulnux sökning – med knappen, eller automatiskt om du slagit på det.",
  "key": "",
  "permissions": ["scripting", "tabs"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "bakgrund.js" },
  "action": {
    "default_title": "Spara sidan i Gulnux sök",
    "default_icon": { "16": "ikoner/sok-16.png", "32": "ikoner/sok-32.png", "48": "ikoner/sok-48.png" }
  },
  "icons": { "16": "ikoner/sok-16.png", "48": "ikoner/sok-48.png", "128": "ikoner/sok-128.png" }
}
