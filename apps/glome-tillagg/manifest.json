{
  "manifest_version": 3,
  "name": "Gulnux search",
  "version": "0.1.0",
  "description": "Save the page you are reading to Gulnux search – with the button, or automatically if you turned that on.",
  "key": "",
  "permissions": ["scripting", "tabs"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "bakgrund.js" },
  "action": {
    "default_title": "Save this page to Gulnux search",
    "default_icon": { "16": "ikoner/sok-16.png", "32": "ikoner/sok-32.png", "48": "ikoner/sok-48.png" }
  },
  "icons": { "16": "ikoner/sok-16.png", "48": "ikoner/sok-48.png", "128": "ikoner/sok-128.png" }
}
