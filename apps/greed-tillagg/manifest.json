{
  "manifest_version": 3,
  "name": "Greed",
  "version": "0.1.0",
  "description": "Your self-curating feed: collects the posts you scroll past on Facebook, Instagram and X, and opens Greed.",
  "key": "",
  "permissions": ["tabs"],
  "host_permissions": ["http://127.0.0.1:9303/*"],
  "background": { "service_worker": "bakgrund.js" },
  "content_scripts": [
    {
      "matches": ["https://*.facebook.com/*", "https://*.instagram.com/*", "https://x.com/*", "https://twitter.com/*"],
      "js": ["innehall.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Open Greed",
    "default_icon": { "16": "ikoner/greed-16.png", "32": "ikoner/greed-32.png", "48": "ikoner/greed-48.png" }
  },
  "icons": { "16": "ikoner/greed-16.png", "48": "ikoner/greed-48.png", "128": "ikoner/greed-128.png" }
}
