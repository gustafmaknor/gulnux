{
  "manifest_version": 3,
  "name": "Good Times",
  "version": "0.1.0",
  "description": "Teach your computer the work you do in a web app. Click on the app you want Good Times to learn.",
  "key": "",
  "permissions": ["nativeMessaging", "tabs"],
  "background": { "service_worker": "bakgrund.js" },
  "action": {
    "default_title": "Teach Good Times this app",
    "default_icon": { "16": "ikoner/gt-16.png", "32": "ikoner/gt-32.png", "48": "ikoner/gt-48.png" }
  },
  "icons": { "16": "ikoner/gt-16.png", "48": "ikoner/gt-48.png", "128": "ikoner/gt-128.png" }
}
